<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="@raw/winkelkoerner_rootca" />
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="true">myfritz.net</domain>
        <domain includeSubdomains="true">nightscout.local</domain>
        <trust-anchors>
            <certificates src="@raw/winkelkoerner_rootca"/>
        </trust-anchors>
    </domain-config>
</network-security-config>
